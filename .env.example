# Destinataire : votre adresse pour recevoir les demandes de réservation
BOOKING_NOTIFY_EMAIL=vous@exemple.com

# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=

# Optionnel — domaine vérifié chez Resend (sinon compte de test : onboarding@resend.dev)
# BOOKING_EMAIL_FROM=The Grand Appartement <reservation@votredomaine.com>

# Stripe — https://dashboard.stripe.com/apikeys (mode Test puis Live)
STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL publique du site (liens dans les e-mails de confirmation)
# NUXT_PUBLIC_SITE_URL=https://www.votredomaine.fr