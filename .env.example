# Supabase — obligatoire pour les sites /:slug (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role : API serveur uniquement (ne jamais exposer au client)
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=

# Optionnel — domaine vérifié chez Resend (sinon compte de test : onboarding@resend.dev)
# Ne pas mettre de commentaire # en fin de ligne (dotenv l’ajoute à la valeur).
# BOOKING_EMAIL_FROM=The Grand Appartement <reservation@votredomaine.com>

# Destinataire du formulaire de contact Hostiv (/contact)
# HOSTIV_CONTACT_EMAIL=contact@votredomaine.com

# Stripe — https://dashboard.stripe.com/apikeys (mode Test puis Live)
STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook — https://dashboard.stripe.com/webhooks (événement account.updated)
STRIPE_WEBHOOK_SECRET=
# Commission Hostiv sur réservations Connect (0–100, défaut 0)
# HESTIA_PLATFORM_FEE_PERCENT=5

# Chemin de base (laisser / pour Hostiv à la racine + sites sous /:slug)
# NUXT_APP_BASE_URL=/

# Slug du site démo lié depuis la landing Hostiv (défaut : thegrandappartement)
# NUXT_PUBLIC_DEMO_PROPERTY_SLUG=thegrandappartement

# URL publique Hostiv (e-mails, redirections Stripe). En local, l’origine de la requête
# est utilisée même si cette variable pointe vers la production.
# NUXT_PUBLIC_SITE_URL=https://hostiv.fr

# Bucket Storage des images sites (défaut : property-assets)
# NUXT_PUBLIC_PROPERTY_ASSETS_BUCKET=property-assets

# Secret pour les tâches planifiées Vercel Cron (envoyé automatiquement en Bearer Authorization)
# CRON_SECRET=

# Clé de chiffrement des inscriptions en attente (obligatoire en production)
# Générer : openssl rand -base64 32
# HOSTIV_SIGNUP_ENCRYPTION_KEY=

# E-mails autorisés pour l’admin plateforme Hostiv (/admin), séparés par des virgules
# HOSTIV_PLATFORM_ADMIN_EMAILS=michael.blin@gmail.com